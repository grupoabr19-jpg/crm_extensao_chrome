{
  "manifest_version": 3,
  "name": "ABR CRM WhatsApp Web MVP",
  "version": "0.2.0",
  "description": "Painel MVP do CRM ABR sobre WhatsApp Web: diagnostico, ficha manual e handoff seguro.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://localhost:10000/*",
    "http://127.0.0.1:10000/*",
    "https://*.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["probe.js", "panel.js"],
      "run_at": "document_idle"
    }
  ]
}
