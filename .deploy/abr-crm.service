[Unit]
Description=ABR CRM API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
WorkingDirectory=/opt/abr-crm
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/npm run api:start
Restart=always
RestartSec=5
MemoryMax=380M

[Install]
WantedBy=multi-user.target
