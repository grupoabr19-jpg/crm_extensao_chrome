[Unit]
Description=ABR WhatsApp Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
WorkingDirectory=/opt/abr-crm
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/npm run bot:whatsapp
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
