{
  "name": "abr-crm",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "api:dev": "npm run dev --workspace @abr/api",
    "api:start": "npm run start --workspace @abr/api",
    "db:migrate": "npm run db:migrate --workspace @abr/api",
    "smoke:test": "npm run smoke:test --workspace @abr/api",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.base.json"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.0",
    "@types/node": "^22.0.0",
    "jsdom": "^30.1.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "zod": "^3.23.0"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
