{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "noEmit": true, "types": ["node"], "resolveJsonModule": true,
    "paths": { "@abr/contracts": ["./packages/contracts/src/index.ts"], "@abr/domain": ["./packages/domain/src/index.ts"] }
  },
  "include": ["packages/*/src", "packages/*/test", "apps/*/src", "apps/*/test"]
}
