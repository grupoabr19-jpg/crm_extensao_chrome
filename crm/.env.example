# Somente backend. Nunca coloque estas variaveis no build da extensao.

# Runtime
NODE_ENV=development
PORT=10000
LOG_LEVEL=info

# Storage
# Use "postgres" para Neon/Postgres e "memory" apenas para teste local descartavel.
ABR_STORAGE=postgres

# Neon/Postgres
# Use a URL pooled do Neon para o trafego normal da aplicacao.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
# Use a URL direta do Neon para migrations, dumps e tarefas administrativas.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require
PGPOOL_MAX=10

# Groq / IA
GROQ_API_KEY=__preencher_no_render__
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Seguranca backend
AUTH_SIGNING_SECRET=__gerar_valor_aleatorio_longo__
API_ADMIN_TOKEN=__token_admin_para_smoke_tests__
ADMIN_ORIGIN=https://admin.exemplo.com.br
ALLOWED_EXTENSION_IDS=__id_da_extensao__

# Smoke tests
# Para testar Render, use a URL publica do servico. Localmente pode deixar localhost.
ABR_API_BASE_URL=http://127.0.0.1:10000
API_BASE_URL=http://127.0.0.1:10000

# Numeros teste para validar transferencia sem depender de clientes reais.
ABR_TEST_CUSTOMER_PHONE=+5511970000001
ABR_TEST_DESTINATION_PHONE=+5511980000001
ABR_TEST_DESTINATION_NAME=Vendedor ABR Teste

# WhatsApp Bot Playwright
# Roda em Chromium isolado, com perfil persistente em crm/.local/whatsapp-bot-profile.
WHATSAPP_BOT_ENABLED=false
WHATSAPP_BOT_MODE=auto
WHATSAPP_BOT_HEADLESS=false
WHATSAPP_BOT_HIDE_WINDOW=true
WHATSAPP_BOT_API_BASE_URL=http://127.0.0.1:10000
WHATSAPP_BOT_ALLOWED_EMAIL=thiago.almeida@grupoabr.com.br
WHATSAPP_BOT_MAIN_PHONE=+5535997709232
WHATSAPP_BOT_CRM_EMAIL=thiago.almeida@grupoabr.com.br
WHATSAPP_BOT_CRM_PASSWORD=__senha_do_crm__
WHATSAPP_BOT_POLL_MS=15000
WHATSAPP_BOT_COMMIT_READY=false
WHATSAPP_BOT_ACTIVE_CHAT_ONLY=true
WHATSAPP_BOT_PIETRA_NAME=Pietra
WHATSAPP_BOT_PIETRA_PHONE=+5535998087702
WHATSAPP_BOT_MAX_CHATS_PER_TICK=1
WHATSAPP_BOT_CHAT_COOLDOWN_MS=120000
WHATSAPP_BOT_TRAINING_FILE=apps/whatsapp-bot/training/abr-bot-training.json
